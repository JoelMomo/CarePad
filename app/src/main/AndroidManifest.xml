<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission
        android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <permission
        android:name="dev.carepad.permission.MODULE_SETTINGS"
        android:protectionLevel="signature" />

    <uses-permission
        android:name="dev.carepad.permission.MODULE_SETTINGS" />

    <queries>

        <intent>
            <action android:name="dev.carepad.action.MODULE" />
        </intent>

        <intent>
            <action android:name="dev.carepad.action.OPEN_MODULE_SETTINGS" />
        </intent>

        <package
            android:name="com.retroarch.aarch64" />

        <package
            android:name="com.fastemulator.gba" />

        <package
            android:name="com.fastemulator.gbafree" />

        <package
            android:name="com.github.stenzek.duckstation" />

        <package
            android:name="xyz.aethersx2.android" />

        <package
            android:name="org.ppsspp.ppsspp" />

        <package
            android:name="me.magnum.melondualds" />

        <package
            android:name="org.dolphinemu.dolphinemu" />

        <package
            android:name="org.azahar_emu.azahar" />

        <package
            android:name="io.github.azaharplus.android" />

        <package
            android:name="org.vita3k.emulator" />

        <package
            android:name="dev.eden.eden_emulator" />

        <package
            android:name="info.cemu.cemu" />

        <package
            android:name="net.rpcsx" />

    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThorDoctor">

        <activity
            android:name=".MainActivity"
            android:enabled="${docThorMainEnabled}"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ThorDoctor">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <receiver
            android:name=".modules.host.recovery.ModuleRecoveryStatusReceiver"
            android:exported="false" />

    </application>

</manifest>
